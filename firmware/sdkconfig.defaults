# --- flash / partitions ---
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# --- build for size (no PSRAM: RAM and flash are both tight) ---
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# --- TLS: Mozilla CA bundle so *.icloud.com verifies without bundled certs ---
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
# iCloud sends full 16 KB TLS records, so keep the inbound content buffer at the
# max; shrink only the outbound side (our requests are small) to save heap.
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=16384
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096
# No PSRAM: the handshake must fit in ~35 KB of free heap. Dynamic buffers grow
# the RX buffer only as records arrive (instead of a static 16 KB up front) and
# free the CA cert + handshake config once the session is up. This is what makes
# the TLS connection to iCloud possible while Wi-Fi + LVGL are both resident.
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CA_CERT=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y

# --- FatFs on SD: long filenames for state/*.map ---
CONFIG_FATFS_LFN_HEAP=y

# --- SNTP: room for three servers, not one. A single hard-coded pool name that
# will not resolve (or whose UDP 123 the router eats) is indistinguishable from
# "the clock was already fine", because the restored NVS checkpoint always looks
# plausible. Fallbacks make a real failure rare enough to be worth reporting. ---
CONFIG_LWIP_SNTP_MAX_SERVERS=3

# --- the sync runs in the main task; give it headroom ---
# 12288 overflowed on hardware: ui_init() alone peaks at ~10.3 KB building the
# lock-screen dashboard, for ~12.8 KB total against a 12 KB stack -- a hard
# boot loop ("stack overflow in task main", every boot, right after LVGL init).
# Measured on device with uxTaskGetStackHighWaterMark; 16 KB leaves ~3.5 KB.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# --- LVGL: monochrome theme for the PalmOS grayscale look ---
CONFIG_LV_USE_THEME_MONO=y
# Shrink LVGL's heap pool from the 64 KB default -- the freed RAM is what the TLS
# handshake + sync working set need.
# 24 KB is NOT enough once the lock-screen dashboard is resident: measured on
# device, the dashboard leaves 788 bytes free with a 648-byte largest block and
# rising fragmentation. The pool does not report "lv_malloc failed" when it gets
# that tight -- instead a label's glyph draw cannot allocate a draw task and
# lv_draw_dispatch spins forever, which reads as a frozen dashboard with missing
# elements and an unlock swipe that never registers (the same loop starves touch).
# 32 KB leaves ~9.7 KB free at 7% fragmentation, steady across repeated repaints,
# and costs ~8 KB of ESP heap (103 KB -> 95 KB free at boot).
CONFIG_LV_MEM_SIZE_KILOBYTES=32

# --- Wi-Fi: trim the (generous) default buffer pools to claw back heap for TLS.
# Sync is low-bandwidth, so fewer RX/TX buffers is fine.
# MEASURED 2026-08-20: with Wi-Fi up and the UI resident there were 23 KB free
# and the handshake bottomed out at 880 bytes -- every HTTPS request in the sync
# failed with ESP_ERR_HTTP_CONNECT, iCloud and all ten feeds alike. Wi-Fi itself
# accounted for 26 KB of that (free went 23 KB -> 50 KB when it came down), so
# these pools are halved again. The cost is throughput on a sync that moves a few
# hundred KB at most; the benefit is a handshake that completes. ---
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=3
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n

# --- quieter default log level ---
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# --- power: automatic light-sleep for battery life (power.c) ---
# DFS + tickless idle let the SoC light-sleep during the idle delays between LVGL
# frames; power.c calls esp_pm_configure(light_sleep_enable). Wi-Fi/SD drivers
# hold PM locks while active so a sync is never interrupted. To disable
# light-sleep (e.g. if it disturbs touch/display on a given board), comment out
# these two lines and rebuild -- the PWM backlight + idle screen-off still work.
# DISABLED 2026-07-10: on this CYD, automatic light-sleep stops the APB clock
# between LVGL frames and the display/backlight glitches every cycle -- the
# screen visibly flashes on/off. PWM backlight + idle screen-off are unaffected
# and remain active. Re-enable only with a board that tolerates APB gating.
#CONFIG_PM_ENABLE=y
#CONFIG_FREERTOS_USE_TICKLESS_IDLE=y

# The peer certificate is verified during the handshake and never inspected
# afterwards (nothing in esp-tls or in this project calls mbedtls_ssl_get_peer_cert),
# so keeping the chain for the life of the session is ~4 KB of pure cost -- and it
# is held during exactly the window the account sync needs it: measured post-tls
# free was 25596 with the sync scratch wanting 23556. TLS 1.3, the only Kconfig
# dependent of this option, is not enabled here.
CONFIG_MBEDTLS_SSL_KEEP_PEER_CERTIFICATE=n

# FatFs sizes every open file's sector cache at FF_MAX_SS, and
# FF_MAX_SS = MAX(FF_SS_SDCARD=512, CONFIG_WL_SECTOR_SIZE). This project mounts
# an SD card (512-byte sectors) and has NO wear-levelled FAT partition at all --
# the table is nvs/phy_init/factory -- so a 4096 wear-levelling sector size was
# charging every open file 4 KB to satisfy a library we never instantiate. Five
# files stay open across the reconcile loop, so it cost ~21.5 KB of exactly the
# heap the sync and the TLS handshake were fighting over. (This is NOT
# CONFIG_FATFS_SECTOR_4096, which only sizes the partition generator.)
CONFIG_WL_SECTOR_SIZE_512=y
