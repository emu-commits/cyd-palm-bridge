# CYD Palm runtime config -- copy to the SD card as /sdcard/config.ini
#
# Parsed by bridge/config.c (config_load). Settings on the device reads and
# writes these values, so Wi-Fi, the zone and the location can change without
# reflashing -- and most people never need to open this file at all.
#
# Format: `key = value`, one per line. '#' starts a comment. Surrounding
# whitespace is ignored; unknown keys and malformed lines are skipped.
#
# PASSWORDS: you may type the Wi-Fi password here, but it does not stay: on
# its next boot the device moves it into its own flash and rewrites this file
# without it, so the card never carries it for long.
# The firmware never logs it.

wifi_ssid = your-ssid
wifi_pass = your-wifi-password

timezone      = America/New_York          # empty = floating local time

# Weather location, decimal degrees (east/north positive). Empty = no weather.
# Forecast resolution is kilometres, so a rough figure for your town is plenty.
latitude      = 40.7143
longitude     = -74.0060

brightness    = 80                        # backlight 0..100
backlight_sec = 30                        # dim after N idle seconds (0 = never)

# (The iCloud account and collection keys of the archived calendar/contacts
# sync are still read, so an old card's file loads, but nothing uses them.)
